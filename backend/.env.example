# ──────────────────────────────────────────────────────────
# Turso Cloud DB (Production)
# Get these values from: turso db show <your-db-name>
# ──────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ──────────────────────────────────────────────────────────
# Local Dev Fallback (only used when TURSO_DATABASE_URL is empty)
# ──────────────────────────────────────────────────────────
DB_PATH=backend.db

# ──────────────────────────────────────────────────────────
# Server Port (Render sets this automatically)
# ──────────────────────────────────────────────────────────
PORT=8080
